{
  "name": "dynamodb-console-ui",
  "version": "0.1.0",
  "description": "A standalone interface for browsing DynamoDB tables and running SQL-like read queries.",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CZhang1997/dynamodb-console-ui.git"
  },
  "keywords": [
    "aws",
    "dynamodb",
    "database",
    "electron",
    "react"
  ],
  "main": "index.js",
  "homepage": "./",
  "dependencies": {
    "@testing-library/jest-dom": "^5.17.0",
    "@testing-library/react": "^13.4.0",
    "@testing-library/user-event": "^13.5.0",
    "aws-sdk": "^2.1522.0",
    "bootstrap": "^5.3.2",
    "dexie": "^3.2.4",
    "file-saver": "^2.0.5",
    "react": "^18.2.0",
    "react-bootstrap": "^2.9.1",
    "react-dom": "^18.2.0",
    "react-drag-drop-files": "^2.3.10",
    "react-icons": "^4.12.0",
    "react-router-dom": "^6.21.1",
    "react-scripts": "5.0.1",
    "react-select": "^5.8.0",
    "react-toastify": "^9.1.3",
    "sheetjs-style": "^0.15.8",
    "web-vitals": "^2.1.4"
  },
  "scripts": {
    "start": "react-scripts start",
    "build": "react-scripts build",
    "test": "react-scripts test",
    "eject": "react-scripts eject",
    "electron": "react-scripts build && electron .",
    "electron:build": "react-scripts build && electron-builder -c.extraMetadata.main=index.js"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1"
  },
  "build": {
    "appId": "com.crz97.dynamodb-console-ui",
    "productName": "DynamoDB Console UI",
    "mac": {
      "target": "dmg",
      "category": "public.app-category.developer-tools"
    },
    "files": [
      "build/**/*",
      "node_modules/**/*",
      "public/**/*",
      "index.js",
      "package.json"
    ],
    "directories": {
      "buildResources": "build"
    }
  }
}
